# =============================================================================
#  First-order decay              dA/dt = -k * A          A(t) = A0 * exp(-k t)
# =============================================================================
#  The simplest possible kinetics, used here to talk about UNCERTAINTY rather
#  than point estimates: given noisy data, what is the *distribution* of
#  plausible parameter values? We fit the decay rate k and the initial amount A0
#  and quantify their uncertainty two ways -- Bayesian sampling and bootstrapping.
# =============================================================================

begin model

  begin parameters
    k    0.5    # decay rate       [1/day]   <- FITTED
    A0   100    # initial amount   [AU]      <- FITTED
  end parameters

  begin molecule types
    A()
  end molecule types

  begin seed species
    A()  A0
  end seed species

  begin observables
    Molecules  Obs_A  A()
  end observables

  begin reaction rules
    decay: A() -> 0  k        # dA/dt = -k*A
  end reaction rules

end model
