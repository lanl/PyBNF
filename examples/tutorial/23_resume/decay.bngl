# first-order decay  A -> 0  (dA/dt = -k*A)   clean edition-2
begin model
  begin parameters
    k   0.5    # decay rate [1/s]   <- FITTED
    A0  100    # initial amount      <- FITTED
  end parameters
  begin molecule types
    A()
  end molecule types
  begin seed species
    A()  A0
  end seed species
  begin observables
    Molecules  Obs_A  A()
  end observables
  begin reaction rules
    R_decay: A() -> 0  k
  end reaction rules
end model
