begin model

  begin parameters
    # A parabola y = v1*x^2 + v2*x + v3 over a linearly growing counter x.
    # s_lo / s_hi / sig are NOT model parameters: they are PEtab per-measurement noise
    # nuisances. The noiseFormula noiseParameter1_obs_y * noiseParameter2_obs_y binds a
    # ROW-VARYING scale (s_lo on t0/t2, s_hi on t1) times a shared sigma, both estimated,
    # bound per data point from the measurement_params sidecar (ADR-0075, the multi-token
    # generalization of ADR-0045).
    v1 0.5
    v2 1
    v3 3
  end parameters

  begin molecule types
    counter()
  end molecule types

  begin seed species
    counter() -10
  end seed species

  begin observables
    Molecules x counter()
  end observables

  begin functions
    y()=v1*(x^2)+(v2*x)+v3
  end functions

  begin reaction rules
    0->counter() 1
  end reaction rules

end model

# New-era (edition 2): the simulation is synthesized from the experiment: line, so the
# model carries no actions block (ADR-0028). Carried byte-verbatim on import (ADR-0036).
