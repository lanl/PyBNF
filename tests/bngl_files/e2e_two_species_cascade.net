# Two-species linear cascade with a multi-species observable.
# dA/dt = k_prod - k_deg*A          A* = k_prod/k_deg
# dB/dt = k_f*A   - k_bdeg*B        B* = k_f*k_prod/(k_deg*k_bdeg)
# Ptot = 2*A + 3*B  (non-unit stoichiometric group -> exercises dg/dx)
begin parameters
    1 k_prod  10
    2 k_deg   1
    3 k_f     1
    4 k_bdeg  1
end parameters
begin species
    1 A() 0
    2 B() 0
end species
begin reactions
    1 0 1 k_prod #_R1
    2 1 0 k_deg #_R2
    3 1 1,2 k_f #_R3
    4 2 0 k_bdeg #_R4
end reactions
begin groups
    1 Ptot    2*1,3*2
end groups
