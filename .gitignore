# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# --- Packaging / build ---
build/
dist/
.eggs/
*.egg-info/
# Keep MANIFEST.in tracked (don’t ignore)

# --- Test & coverage caches ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml

# --- Editors / OS junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Virtual envs (local only; don’t commit them) ---
.venv/
venv/
env/
.env/
.conda/
.mamba/

# --- Dask / PyBNF local temp junk ---
dask-worker-space/
pybnf-dask-*/

# --- Logs generated during runs/tests ---
*.log
tests/*.log
tests/*_stdout.out
tests/*_stderr.out

# --- PyBNF full-tests generated outputs ---
# Ignore per-test run artifacts under tests/full_tests/*/fit/
tests/full_tests/*/fit/